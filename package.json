{
  "name": "animate-mcp",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gekkyo/animate-mcp.git"
  },
  "bugs": "https://github.com/gekkyo/animate-mcp/issues",
  "homepage": "https://github.com/gekkyo/animate-mcp#readme",
  "type": "module",
  "bin": {
    "animate-mcp": "server/dist/index.js"
  },
  "files": [
    "server/dist",
    "server/jsfl"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc --project server/tsconfig.json",
    "test": "tsx --test server/test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage server/test/*.test.ts",
    "start": "node server/dist/index.js",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "tsx": "^4.20.6"
  }
}
