{
  "name": "animate-mcp",
  "version": "0.4.0",
  "description": "MCP server for Adobe Animate: edit scripts, timelines and library, then publish and verify.",
  "mcpName": "io.github.gekkyo/animate-mcp",
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "adobe",
    "adobe-animate",
    "animate",
    "jsfl",
    "actionscript",
    "flash"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gekkyo/animate-mcp.git"
  },
  "bugs": "https://github.com/gekkyo/animate-mcp/issues",
  "homepage": "https://github.com/gekkyo/animate-mcp#readme",
  "type": "module",
  "bin": {
    "animate-mcp": "server/dist/index.js"
  },
  "files": [
    "server/dist",
    "server/jsfl",
    "TOOLS.md",
    "TOOLS.ja.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc --project server/tsconfig.json",
    "test": "tsx --test \"server/test/**/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage \"server/test/**/*.test.ts\"",
    "start": "node server/dist/index.js",
    "call": "node server/scripts/call-tool.mjs",
    "smoke": "node server/verification/smoke/smoke-all.mjs",
    "smoke:bin": "node server/verification/smoke/smoke-bin.mjs",
    "test:readme-e2e": "npm run build && node --test \"server/verification/readme-e2e/test/*.test.mjs\"",
    "lint": "biome check && eslint \"server/**/*.ts\" \"server/**/*.mjs\" \"server/jsfl/**/*.jsfl\"",
    "format": "biome check --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "saxes": "^6.0.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^25.0.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.4.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
